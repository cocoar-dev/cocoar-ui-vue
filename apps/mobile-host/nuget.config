<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: the host restores the same packages on every machine, whatever feeds a user configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
