{
  "name": "@cocoar/vue-calendar",
  "version": "0.0.1",
  "description": "Vue 3 calendar component — Temporal-only public surface, single drop pipeline, per-endpoint source-zone preservation, explicit DST policy. Built on the principles laid out in the Time in Software, Done Right article series.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/calendar"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "calendar",
    "scheduler",
    "agenda",
    "events",
    "recurrence",
    "rrule",
    "virtualization",
    "temporal"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./styles": "./dist/vue-calendar.css",
    "./recurrence": {
      "source": "./src/recurrence/index.ts",
      "import": "./dist/recurrence.js",
      "types": "./dist/recurrence/index.d.ts"
    },
    "./recurrence-rrule-temporal": {
      "source": "./src/recurrence-rrule-temporal/index.ts",
      "import": "./dist/recurrence-rrule-temporal.js",
      "types": "./dist/recurrence-rrule-temporal/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "rrule-temporal": "~1.5.3"
  },
  "peerDependencies": {
    "@cocoar/vue-localization": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cocoar/vue-localization": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "fast-check": "^4.7.0",
    "vue": "^3.5.32"
  }
}
