{
  "name": "@cocoar/vue-markdown-form",
  "version": "0.0.1",
  "description": "Template-driven Markdown forms with fixed prose, registered field controls, separate values and readonly rendering.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/markdown-form"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "form",
    "template"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "styles/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/markdown-form.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cocoar/vue-markdown": "workspace:*",
    "@cocoar/vue-markdown-core": "workspace:*",
    "@cocoar/vue-markdown-editor": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependencies": {
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.32"
  }
}
