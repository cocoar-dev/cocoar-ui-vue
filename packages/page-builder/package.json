{
  "name": "@cocoar/vue-page-builder",
  "version": "0.0.1",
  "description": "Generic headless visual page builder and renderer for Vue 3 built on the Cocoar Design System",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/page-builder"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "page-builder",
    "low-code",
    "visual-editor"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue",
    "**/pageScriptRuntime.worker.*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime-worker": {
      "source": "./src/runtimeWorkerEntry.ts",
      "import": "./dist/runtime-worker.js",
      "types": "./dist/runtimeWorkerEntry.d.ts"
    },
    "./styles": "./dist/index.css"
  },
  "imports": {
    "#page-runtime-worker": {
      "source": "./src/runtimeWorkerEntry.ts",
      "types": "./dist/runtimeWorkerEntry.d.ts",
      "default": "./dist/runtime-worker.js"
    }
  },
  "files": [
    "dist",
    "IDP_INTEGRATION.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "@cocoar/vue-localization": "workspace:*",
    "@cocoar/vue-script-editor": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "monaco-editor": "^0.55.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cocoar/vue-localization": "workspace:*",
    "@cocoar/vue-script-editor": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "monaco-editor": "^0.55.1",
    "vue": "^3.5.32"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "ses": "2.2.0"
  }
}
