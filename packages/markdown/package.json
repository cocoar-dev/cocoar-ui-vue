{
  "name": "@cocoar/vue-markdown",
  "version": "0.0.1",
  "description": "Markdown viewer + shared rendering registry for Vue 3. The viewer (`<CoarMarkdown>`) and the editor (`@cocoar/vue-markdown-editor`) consume the same component map so a code block, table, etc. looks identical in both contexts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "viewer",
    "renderer",
    "registry"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/markdown-blocks.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cocoar/vue-markdown-core": "workspace:*"
  },
  "peerDependencies": {
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.32"
  }
}
