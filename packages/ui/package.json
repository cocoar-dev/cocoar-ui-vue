{
  "name": "@cocoar/vue-ui",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/all.css",
    "./styles/*": "./styles/*"
  },
  "files": ["dist", "styles"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cocoar/vue-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  }
}
