{
  "name": "@cocoar/vue-ui",
  "version": "0.0.1",
  "description": "Cocoar Design System — a touch-first Vue 3 component library with 30+ accessible, themeable components",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/ui"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui",
    "accessible",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/fonts.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/bundle.css",
    "./fonts": {
      "source": "./src/fonts.ts",
      "import": "./dist/fonts.js",
      "types": "./dist/fonts.d.ts"
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cocoar/vue-fragment-parser": "workspace:*",
    "@cocoar/vue-localization": "workspace:*",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@js-temporal/polyfill": "^0.5.0",
    "@maskito/core": "^5.1.1",
    "@maskito/kit": "^5.1.1",
    "@maskito/vue": "^5.1.1",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "overlayscrollbars": "^2.14.0",
    "vue": "^3.5.0"
  }
}
