{
  "name": "@cocoar/vue-markdown-editor",
  "version": "0.0.1",
  "description": "WYSIWYG Markdown editor for Vue 3 based on Milkdown, with Cocoar Design System styling",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui-vue.git",
    "directory": "packages/markdown-editor"
  },
  "homepage": "https://docs.cocoar.dev/cocoar-ui-vue/",
  "bugs": "https://github.com/cocoar-dev/cocoar-ui-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "editor",
    "wysiwyg",
    "milkdown",
    "prosemirror"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@cocoar/vue-markdown": "workspace:*",
    "@cocoar/vue-markdown-core": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "unified": "^11.0.5",
    "@milkdown/core": "^7.20.0",
    "@milkdown/ctx": "^7.20.0",
    "@milkdown/kit": "^7.20.0",
    "@milkdown/plugin-clipboard": "^7.20.0",
    "@milkdown/plugin-history": "^7.20.0",
    "@milkdown/plugin-listener": "^7.20.0",
    "@milkdown/preset-commonmark": "^7.20.0",
    "@milkdown/preset-gfm": "^7.20.0",
    "remark-frontmatter": "^5.0.0",
    "@milkdown/prose": "^7.20.0",
    "@milkdown/utils": "^7.20.0",
    "@milkdown/vue": "^7.20.0"
  },
  "devDependencies": {
    "@cocoar/vue-markdown": "workspace:*",
    "@cocoar/vue-markdown-core": "workspace:*",
    "@cocoar/vue-ui": "workspace:*",
    "@types/mdast": "^4.0.4",
    "vue": "^3.5.32"
  }
}
